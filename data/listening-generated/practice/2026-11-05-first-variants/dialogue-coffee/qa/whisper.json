			"timestamps": {
				"from": "00:00:44,380",
				"to": "00:00:46,380"
			},
			"offsets": {
				"from": 44380,
				"to": 46380
			},
			"text": " Εγώ αγοράζω και νερό."
		},
		{
			"timestamps": {

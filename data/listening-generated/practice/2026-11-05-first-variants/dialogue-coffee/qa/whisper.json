			"offsets": {
				"from": 0,
				"to": 2840
			},
			"text": " Γεια σου, Ελένη. Θέλεις έναν καφέ?"
		},
		{
			"timestamps": {
				"from": "00:00:02,840",
				"to": "00:00:07,320"
			},
			"offsets": {
				"from": 2840,
				"to": 7320
			},
			"text": " Ναι, ευχαριστώ. Προτιμάω κρύο καφέ. Εσύ?"
		},
		{
			"timestamps": {
				"from": "00:00:07,320",
				"to": "00:00:11,260"
			},
			"offsets": {
				"from": 7320,
				"to": 11260
			},
			"text": " Εγώ προτιμάω ζεστό καφέ. Τι κάνεις τώρα?"
		},
		{
			"timestamps": {
				"from": "00:00:11,260",
				"to": "00:00:15,660"
			},
			"offsets": {
				"from": 11260,
				"to": 15660
			},
			"text": " Περιμένω την αδελφή μου. Δουλεύει στο φαρμακείο."
		},
		{
			"timestamps": {
				"from": "00:00:15,660",
				"to": "00:00:17,600"
			},
			"offsets": {
				"from": 15660,
				"to": 17600
			},
			"text": " Είναι φαρμακοποιός."
		},
		{
			"timestamps": {
				"from": "00:00:17,600",
				"to": "00:00:20,620"
			},
			"offsets": {
				"from": 17600,
				"to": 20620
			},
			"text": " Ναι. Εσύ τι δουλειά κάνεις?"
		},
		{
			"timestamps": {
				"from": "00:00:20,620",
				"to": "00:00:25,260"
			},
			"offsets": {
				"from": 20620,
				"to": 25260
			},
			"text": " Διδάσκω ελληνικά. Η γυναίκα μου είναι μηχανικός."
		},
		{
			"timestamps": {
				"from": "00:00:25,260",
				"to": "00:00:27,100"
			},
			"offsets": {
				"from": 25260,
				"to": 27100
			},
			"text": " Μιλάει ελληνικά."
		},
		{
			"timestamps": {
				"from": "00:00:27,100",
				"to": "00:00:28,940"
			},
			"offsets": {
				"from": 27100,
				"to": 28940
			},
			"text": " Όχι πολύ καλά."
		},
		{
			"timestamps": {
				"from": "00:00:30,000",
				"to": "00:00:30,880"
			},
			"offsets": {
				"from": 30000,
				"to": 30880
			},
			"text": " Μαθαίνει τώρα."
		},
		{
			"timestamps": {
				"from": "00:00:30,880",
				"to": "00:00:33,760"
			},
			"offsets": {
				"from": 30880,
				"to": 33760
			},
			"text": " Εμείς μιλάμε ελληνικά στο σπίτι."
		},
		{
			"timestamps": {
				"from": "00:00:33,760",
				"to": "00:00:36,560"
			},
			"offsets": {
				"from": 33760,
				"to": 36560
			},
			"text": " Η μητέρα μου είναι από την Ελλάδα."
		},
		{
			"timestamps": {
				"from": "00:00:36,560",
				"to": "00:00:37,720"
			},
			"offsets": {
				"from": 36560,
				"to": 37720
			},
			"text": " Ωραία."
		},
		{
			"timestamps": {
				"from": "00:00:37,720",
				"to": "00:00:40,100"
			},
			"offsets": {
				"from": 37720,
				"to": 40100
			},
			"text": " Εγώ μιλάω ελληνικά στη δουλειά."
		},
		{
			"timestamps": {
				"from": "00:00:40,100",
				"to": "00:00:43,260"
			},
			"offsets": {
				"from": 40100,
				"to": 43260
			},
			"text": " Τώρα αγοράζω έναν καφέ για την αδελφή μου."
		},
		{
			"timestamps": {
				"from": "00:00:43,260",
				"to": "00:00:44,380"
			},
			"offsets": {
				"from": 43260,
				"to": 44380
			},
			"text": " Εσύ?"

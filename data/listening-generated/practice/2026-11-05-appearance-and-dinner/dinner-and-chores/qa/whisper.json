				"from": "00:00:05,800",
				"to": "00:00:09,600"
			},
			"offsets": {
				"from": 5800,
				"to": 9600
			},
			"text": " Όχι, δεν τρώω κρέας. Προτιμάω ψάρι."
		},
		{
			"timestamps": {
				"from": "00:00:09,600",
				"to": "00:00:13,060"
			},
			"offsets": {
				"from": 9600,
				"to": 13060
			},
			"text": " Εντάξει. Παραγγέλνουμε ψάρι."
		},
		{

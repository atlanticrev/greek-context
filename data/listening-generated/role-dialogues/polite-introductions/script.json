  "turns": [
    {
      "role": "danai",
      "text": "Καλώς ήρθατε. Με λένε Δανάη Λούρη.",
      "scene": 1
    },
    {
      "role": "danai",
      "text": "Γεια σου Μαράλ. Τι κάνεις;",
      "scene": 2
    },
    {
      "role": "maral",
      "text": "Πολύ καλά Δανάη. Ευχαριστώ.",
      "scene": 2
    },
    {
      "role": "danai",
      "text": "Πώς σας λένε;",
      "scene": 3
    },
    {
      "role": "thomas",
      "text": "Με λένε Τόμας Μόρτον.",
      "scene": 3
    },
    {
      "role": "danai",
      "text": "Από πού είστε κύριε Μόρτον;",
      "scene": 3
    },
    {
      "role": "thomas",
      "text": "Είμαι από την Αγγλία. Και όχι κύριε Μόρτον, Τόμας παρακαλώ.",
      "scene": 3
    },
    {
      "role": "danai",
      "text": "Εντάξει. Καλώς ήρθες Τόμας.",
      "scene": 3
    },
    {
      "role": "nikola",
      "text": "Πώς σε λένε;",
      "scene": 4
    },
    {
      "role": "cecile",
      "text": "Με λένε Σεσίλ Λαφόν. Και σένα;",
      "scene": 4
    },
    {
      "role": "nikola",
      "text": "Εμένα με λένε Νικόλα.",
      "scene": 4
    },
    {
      "role": "cecile",
      "text": "Νικόλα, από εδώ ο άντρας μου, ο Φιλίπ.",
      "scene": 4
    },
    {
      "role": "philippe",
      "text": "Χαίρομαι πολύ, Νικόλα. Από πού είσαι;",
      "scene": 4
    },
    {
      "role": "nikola",
      "text": "Είμαι από την Αλβανία.",
      "scene": 4
    }

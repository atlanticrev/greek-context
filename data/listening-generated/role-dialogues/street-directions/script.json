  "casting_note": "Учебная читка двумя голосами LFM. Для каждой роли закреплён один пресет. Три персонажа и два чтеца: Πέδρο и Μάρκος используют один мужской пресет, Βέρα — женский.",
  "roles": {
    "vera": {
      "label": "Βέρα",
      "voice": "female-greek"
    },
    "pedro": {
      "label": "Πέδρο",
      "voice": "male-greek"
    },
    "markos": {
      "label": "Μάρκος",
      "voice": "male-greek"
    }
  },
  "turns": [
    {
      "role": "vera",
      "text": "Γεια σας. Ξέρετε το Πάρκο Ελευθερίας.",
      "scene": 1
    },
    {
      "role": "pedro",
      "text": "Συγγνώμη, δεν καταλαβαίνω.",
      "scene": 1
    },
    {
      "role": "vera",
      "text": "Α, δεν μιλάτε ελληνικά.",
      "scene": 1
    },
    {
      "role": "pedro",
      "text": "Όχι ελληνικά. Ισπανικά.",
      "scene": 1
    },
    {
      "role": "vera",
      "text": "Εγώ δεν μιλάω ισπανικά καθόλου. Αγγλικά.",
      "scene": 1
    },
    {
      "role": "pedro",
      "text": "Ε, λίγο. Μάρκος μιλάει ελληνικά. Μάρκος.",
      "scene": 1
    },
    {
      "role": "markos",
      "text": "Ναι, τι θέλετε.",
      "scene": 1
    },
    {
      "role": "vera",
      "text": "Το Πάρκο Ελευθερίας.",
      "scene": 1
    },
    {
      "role": "markos",
      "text": "Ναι, εδώ είναι. Τι ψάχνετε.",
      "scene": 1
    },
    {
      "role": "vera",
      "text": "Ψάχνω τον κινηματογράφο Στούντιο.",
      "scene": 1
    },
    {
      "role": "markos",
      "text": "Μάλιστα. Βλέπετε την Εθνική Τράπεζα. Εκεί είναι.",
      "scene": 1
    },
    {
      "role": "vera",
      "text": "Ευχαριστώ.",
      "scene": 1
    }
  ]
}

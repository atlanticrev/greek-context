			"timestamps": {
				"from": "00:00:14,780",
				"to": "00:00:20,380"
			},
			"offsets": {
				"from": 14780,
				"to": 20380
			},
			"text": " Ε, λίγο. Μάρκος μιλάει ελληνικά. Μάρκος."
		},
		{
			"timestamps": {
				"from": "00:00:20,380",
				"to": "00:00:22,600"
			},
			"offsets": {
				"from": 20380,
				"to": 22600
			},
			"text": " Ναι, τι θέλετε."
		},
		{
			"timestamps": {
				"from": "00:00:22,600",
				"to": "00:00:24,580"
			},
			"offsets": {
				"from": 22600,
				"to": 24580
			},
			"text": " Το Πάρκο Ελευθερίας."

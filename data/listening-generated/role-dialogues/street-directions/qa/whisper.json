			},
			"text": " Γεια σας. Ξέρετε το Πάρκο Ελευθερίας."
		},
		{
			"timestamps": {
				"from": "00:00:02,820",
				"to": "00:00:05,840"
			},
			"offsets": {
				"from": 2820,
				"to": 5840
			},
			"text": " Συγγνώμη, δεν καταλαβαίνω."
		},
		{
			"timestamps": {
				"from": "00:00:05,840",
				"to": "00:00:08,300"
			},
			"offsets": {
				"from": 5840,
				"to": 8300
			},
			"text": " Α, δεν μιλάτε ελληνικά."
		},
		{
			"timestamps": {
				"from": "00:00:08,300",
				"to": "00:00:10,820"
			},
			"offsets": {
				"from": 8300,
				"to": 10820
			},
			"text": " Όχι ελληνικά. Ισπανικά."
		},
		{
			"timestamps": {
				"from": "00:00:10,820",
				"to": "00:00:14,780"
			},
			"offsets": {
				"from": 10820,
				"to": 14780
			},
			"text": " Εγώ δεν μιλάω ισπανικά καθόλου. Αγγλικά."

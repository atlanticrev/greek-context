			"offsets": {
				"from": 0,
				"to": 2780
			},
			"text": " Γεια σας. Εδώ είναι η τάξη ΑΟΕΝ."
		},
		{
			"timestamps": {
				"from": "00:00:02,780",
				"to": "00:00:05,520"
			},
			"offsets": {
				"from": 2780,
				"to": 5520
			},
			"text": " Ναι, Έλια. Πώς σε λένε?"
		},
		{
			"timestamps": {
				"from": "00:00:05,520",
				"to": "00:00:07,420"
			},
			"offsets": {
				"from": 5520,
				"to": 7420
			},
			"text": " Με λένε Μάουρο."
		},
		{
			"timestamps": {
				"from": "00:00:07,420",
				"to": "00:00:09,860"
			},
			"offsets": {
				"from": 7420,
				"to": 9860
			},
			"text": " Χαίρο πολύ, Μάριο."
		},
		{
			"timestamps": {
				"from": "00:00:09,860",
				"to": "00:00:13,160"
			},
			"offsets": {
				"from": 9860,
				"to": 13160
			},
			"text": " Όχι Μάριο. Ήμνο Μάουρο."
		},
		{
			"timestamps": {
				"from": "00:00:13,160",
				"to": "00:00:15,780"
			},
			"offsets": {
				"from": 13160,
				"to": 15780
			},
			"text": " Χαίρο πολύ. Είμαι Ιάννε."
		},
		{
			"timestamps": {
				"from": "00:00:15,780",
				"to": "00:00:17,420"
			},
			"offsets": {
				"from": 15780,
				"to": 17420
			},
			"text": " Από πού είσαι?"
		},
		{
			"timestamps": {
				"from": "00:00:17,420",
				"to": "00:00:21,360"
			},
			"offsets": {
				"from": 17420,
				"to": 21360
			},
			"text": " Από την Ισπανία. Από εδώ, Φλαβιάν."
		},
		{
			"timestamps": {
				"from": "00:00:21,360",
				"to": "00:00:23,120"
			},
			"offsets": {
				"from": 21360,
				"to": 23120
			},
			"text": " Γεια σου, Φλαβιάν."
		},
		{
			"timestamps": {
				"from": "00:00:23,120",
				"to": "00:00:26,060"
			},
			"offsets": {
				"from": 23120,
				"to": 26060
			},
			"text": " Γεια. Καλώς ήρθες στην τάξη ΑΟΕΝ."
		},
		{
			"timestamps": {
				"from": "00:00:26,060",
				"to": "00:00:29,480"
			},
			"offsets": {
				"from": 26060,
				"to": 29480
			},
			"text": " Ευχαριστώ. Εσάς, πώς σας λένε?"
		},
		{
			"timestamps": {
				"from": "00:00:30,000",
				"to": "00:00:33,880"
			},
			"offsets": {
				"from": 30000,
				"to": 33880
			},
			"text": " Γεια. Εμείς είμαστε ο Τόμας και η Κριστίν."
		},
		{
			"timestamps": {
				"from": "00:00:33,880",
				"to": "00:00:38,300"
			},
			"offsets": {
				"from": 33880,
				"to": 38300
			},
			"text": " Χαίρο πολύ. Εμένα με λένε Μάωρο. Εσάς?"
		},
		{
			"timestamps": {
				"from": "00:00:38,300",
				"to": "00:00:42,580"
			},
			"offsets": {
				"from": 38300,
				"to": 42580
			},
			"text": " Γεια σου. Εμείς είμαστε η Λίζα και η Μαρία."
		},
		{
			"timestamps": {
				"from": "00:00:42,580",
				"to": "00:00:44,100"
			},
			"offsets": {
				"from": 42580,
				"to": 44100
			},
			"text": " Από πού είστε?"
		},
		{
			"timestamps": {
				"from": "00:00:44,100",
				"to": "00:00:47,040"
			},
			"offsets": {
				"from": 44100,
				"to": 47040
			},
			"text": " Από τη Γερμανία. Εσύ?"
		},
		{
			"timestamps": {
				"from": "00:00:47,040",
				"to": "00:00:52,080"
			},
			"offsets": {
				"from": 47040,
				"to": 52080
			},
			"text": " Τέλεια. Εγώ είμαι από την Ιταλία. Γεια σου, Μάωρο."
		},
		{
			"timestamps": {
				"from": "00:00:52,080",
				"to": "00:00:56,260"
			},
			"offsets": {
				"from": 52080,
				"to": 56260
			},
			"text": " Είμαι ο καθηγητής σας, ο Πέτρος Κοσμίδης."
		},
		{
			"timestamps": {
				"from": "00:00:56,260",
				"to": "00:00:58,680"
			},
			"offsets": {
				"from": 56260,
				"to": 58680
			},
			"text": " Γεια σας, κύριε Πέτρο Κοσμίδη."
		},
		{
			"timestamps": {
				"from": "00:00:59,180",
				"to": "00:01:02,280"
			},
			"offsets": {
				"from": 59180,
				"to": 62280
			},
			"text": " «Χαίρετε». «Καλώς ήρθατε, παιδιά»."
		}

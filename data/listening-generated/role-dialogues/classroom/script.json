  "turns": [
    {
      "role": "mauro",
      "text": "Γεια σας! Εδώ είναι η τάξη Α1.",
      "scene": 1
    },
    {
      "role": "anne",
      "text": "Ναι, έλα! Πώς σε λένε;",
      "scene": 1
    },
    {
      "role": "mauro",
      "text": "Με λένε Μάουρο.",
      "scene": 1
    },
    {
      "role": "anne",
      "text": "Χαίρω πολύ, Μάριο.",
      "scene": 1
    },
    {
      "role": "mauro",
      "text": "Όχι Μάριο, είμαι ο Μάουρο.",
      "scene": 1
    },
    {
      "role": "anne",
      "text": "Χαίρω πολύ, είμαι η Άνε.",
      "scene": 1
    },
    {
      "role": "mauro",
      "text": "Από πού είσαι;",
      "scene": 1
    },
    {
      "role": "anne",
      "text": "Από την Ισπανία. Από εδώ ο Φλαβιάν.",
      "scene": 1
    },
    {
      "role": "mauro",
      "text": "Γεια σου, Φλαβιάν.",
      "scene": 1
    },
    {
      "role": "flavian",
      "text": "Γεια! Καλώς ήρθες στην τάξη Α1.",
      "scene": 1
    },
    {
      "role": "mauro",
      "text": "Ευχαριστώ. Εσάς πώς σας λένε;",
      "scene": 1
    },
    {
      "role": "thomas_christine",
      "text": "Γεια. Εμείς είμαστε ο Τόμας και η Κριστίν.",
      "scene": 1
    },
    {
      "role": "mauro",
      "text": "Χαίρω πολύ. Εμένα με λένε Μάουρο. Εσάς;",
      "scene": 1
    },
    {
      "role": "lisa_maria",
      "text": "Γεια σου. Εμείς είμαστε η Λίζα και η Μαρία.",
      "scene": 1
    },
    {
      "role": "mauro",
      "text": "Από πού είστε;",
      "scene": 1
    },
    {
      "role": "lisa_maria",
      "text": "Από τη Γερμανία. Εσύ;",
      "scene": 1
    },
    {
      "role": "mauro",
      "text": "Τέλεια. Εγώ είμαι από την Ιταλία.",
      "scene": 1
    },
    {
      "role": "teacher",
      "text": "Γεια σου Μάουρο. Είμαι ο καθηγητής σας, ο Πέτρος Κοσμίδης.",
      "scene": 1
    },
    {
      "role": "mauro",
      "text": "Γεια σας κύριε Πέτρο Κοσμίδη.",
      "scene": 1
    },
    {
      "role": "teacher",
      "text": "Χαίρετε! Καλώς ήρθατε παιδιά!",
      "scene": 1
    }
  ]

  "turns": [
    {
      "role": "panagiotis",
      "text": "Καλησπέρα, Λι. Τι είναι αυτό; Φωτογραφία;",
      "scene": 1
    },
    {
      "role": "li",
      "text": "Ναι, από την Κίνα. Η οικογένειά μου.",
      "scene": 1
    },
    {
      "role": "panagiotis",
      "text": "Ααα! Ποιος είναι αυτός;",
      "scene": 1
    },
    {
      "role": "li",
      "text": "Ο πατέρας μου. Τον λένε Χουάνγκ.",
      "scene": 1
    },
    {
      "role": "panagiotis",
      "text": "Αυτή ποια είναι; Η μητέρα σου;",
      "scene": 1
    },
    {
      "role": "li",
      "text": "Ναι.",
      "scene": 1
    },
    {
      "role": "panagiotis",
      "text": "Πώς τη λένε;",
      "scene": 1
    },
    {
      "role": "li",
      "text": "Τη λένε Γκονγκ. Και εδώ είναι ο αδερφός μου, ο Τσου.",
      "scene": 1
    },
    {
      "role": "panagiotis",
      "text": "Είναι παντρεμένος;",
      "scene": 1
    },
    {
      "role": "li",
      "text": "Ναι. Αυτή είναι η γυναίκα του, η Λιέν, και αυτός ο γιος τους, ο Ξιάο.",
      "scene": 1
    },
    {
      "role": "panagiotis",
      "text": "Πολύ ωραία!",
      "scene": 1
    }
  ]
}

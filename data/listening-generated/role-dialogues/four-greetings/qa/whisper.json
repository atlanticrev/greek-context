			"offsets": {
				"from": 0,
				"to": 3660
			},
			"text": " Καλημέρα, παιδιά. Είμαι η κυρία Μαρία. Πώς σας λένε?"
		},
		{
			"timestamps": {
				"from": "00:00:03,660",
				"to": "00:00:05,280"
			},
			"offsets": {
				"from": 3660,
				"to": 5280
			},
			"text": " Είναι ο Μάρκος."
		},
		{
			"timestamps": {
				"from": "00:00:05,280",
				"to": "00:00:07,360"
			},
			"offsets": {
				"from": 5280,
				"to": 7360
			},
			"text": " Εγώ είμαι η Μαρίνα."
		},
		{
			"timestamps": {
				"from": "00:00:07,360",
				"to": "00:00:09,540"
			},
			"offsets": {
				"from": 7360,
				"to": 9540
			},
			"text": " Με λένε Ελένη."
		},
		{
			"timestamps": {
				"from": "00:00:09,540",
				"to": "00:00:11,360"
			},
			"offsets": {
				"from": 9540,
				"to": 11360
			},
			"text": " Κι εγώ είμαι η Σοφία."
		},
		{
			"timestamps": {
				"from": "00:00:11,360",
				"to": "00:00:15,860"
			},
			"offsets": {
				"from": 11360,
				"to": 15860
			},
			"text": " Καλησπέρα, κύριε Γιώργο. Τι κάνετε?"
		},
		{
			"timestamps": {
				"from": "00:00:15,860",
				"to": "00:00:18,800"
			},
			"offsets": {
				"from": 15860,
				"to": 18800
			},
			"text": " Γεια σου, Μανώλη. Είμαι πολύ καλά."
		},
		{
			"timestamps": {
				"from": "00:00:18,800",
				"to": "00:00:20,100"
			},
			"offsets": {
				"from": 18800,
				"to": 20100
			},
			"text": " Εσύ?"
		},
		{
			"timestamps": {
				"from": "00:00:20,100",
				"to": "00:00:21,780"
			},
			"offsets": {
				"from": 20100,
				"to": 21780
			},
			"text": " Έτσι και έτσι."
		},
		{
			"timestamps": {
				"from": "00:00:21,780",
				"to": "00:00:26,840"
			},
			"offsets": {
				"from": 21780,
				"to": 26840
			},
			"text": " Καλημέρα σας. Είμαι ο Σωτήρης Παπαδόπουλος."
		},
		{
			"timestamps": {
				"from": "00:00:26,840",
				"to": "00:00:29,420"
			},
			"offsets": {
				"from": 26840,
				"to": 29420
			},
			"text": " Α, γεια σας, κύριε Παπαδόπουλε."
		},
		{
			"timestamps": {
				"from": "00:00:30,000",
				"to": "00:00:30,520"
			},
			"offsets": {
				"from": 30000,
				"to": 30520
			},
			"text": " Πώς είστε."
		},
		{
			"timestamps": {
				"from": "00:00:30,520",
				"to": "00:00:33,360"
			},
			"offsets": {
				"from": 30520,
				"to": 33360
			},
			"text": " Πολύ καλά. Ευχαριστώ."
		},
		{
			"timestamps": {
				"from": "00:00:33,360",
				"to": "00:00:35,880"
			},
			"offsets": {
				"from": 33360,
				"to": 35880
			},
			"text": " Γεια σου, Αλέξη."
		},
		{
			"timestamps": {
				"from": "00:00:35,880",
				"to": "00:00:39,160"
			},
			"offsets": {
				"from": 35880,
				"to": 39160
			},
			"text": " Α, γεια σου, Λάμπρο. Τι κάνεις."
		},
		{
			"timestamps": {
				"from": "00:00:39,160",
				"to": "00:00:41,320"
			},
			"offsets": {
				"from": 39160,
				"to": 41320
			},
			"text": " Πολύ καλά. Εσύ."
		},
		{
			"timestamps": {
				"from": "00:00:41,320",
				"to": "00:00:45,640"
			},
			"offsets": {
				"from": 41320,
				"to": 45640
			},
			"text": " Μια χαρά από εδώ, οι φίλοι μου, η Αλεξάνδρα."
		},
		{
			"timestamps": {
				"from": "00:00:45,640",
				"to": "00:00:47,800"
			},
			"offsets": {
				"from": 45640,
				"to": 47800
			},
			"text": " Χαίρο πολύ, Αλεξάνδρα."
		},
		{
			"timestamps": {
				"from": "00:00:47,800",
				"to": "00:00:49,520"
			},
			"offsets": {
				"from": 47800,
				"to": 49520
			},
			"text": " Κι εγώ επίσης."
		},
		{
			"timestamps": {
				"from": "00:00:49,520",
				"to": "00:00:51,220"
			},
			"offsets": {
				"from": 49520,
				"to": 51220
			},
			"text": " Από εδώ, η Μάρθα."
		},
		{
			"timestamps": {
				"from": "00:00:51,220",
				"to": "00:00:53,440"
			},
			"offsets": {
				"from": 51220,
				"to": 53440
			},
			"text": " Γεια σας. Χάρηκα."
		},
		{
			"timestamps": {
				"from": "00:00:53,440",
				"to": "00:00:54,940"
			},
			"offsets": {
				"from": 53440,
				"to": 54940
			},
			"text": " Και εμείς."

  "turns": [
    {
      "role": "maria",
      "text": "Καλημέρα παιδιά. Είμαι η κυρία Μαρία. Πώς σας λένε;",
      "scene": 1
    },
    {
      "role": "markos",
      "text": "Είμαι ο Μάρκος.",
      "scene": 1

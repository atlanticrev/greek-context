    {
      "role": "emine",
      "text": "Γεια σου. Πώς σε λένε;",
      "scene": 1
    },
    {
      "role": "petros",
      "text": "Με λένε Πέτρο. Εσένα;",
      "scene": 1
    },
    {
      "role": "emine",
      "text": "Εμινέ.",
      "scene": 1
    },
    {
      "role": "petros",
      "text": "Μιλάς ελληνικά;",
      "scene": 1
    },
    {
      "role": "emine",
      "text": "Όχι πολύ καλά.",
      "scene": 1
    },
    {
      "role": "petros",
      "text": "Από πού είσαι;",
      "scene": 1
    },
    {
      "role": "emine",
      "text": "Είμαι από την Τουρκία, από την Άγκυρα.",
      "scene": 1
    },
    {
      "role": "petros",
      "text": "Και τι δουλειά κάνεις;",
      "scene": 1
    },
    {
      "role": "emine",
      "text": "Είμαι φαρμακοποιός, αλλά τώρα δεν δουλεύω. Μαθαίνω ελληνικά. Εσύ;",
      "scene": 1
    },
    {
      "role": "petros",
      "text": "Είμαι μηχανικός. Πού μένεις, Εμινέ;",
      "scene": 1
    },
    {
      "role": "emine",
      "text": "Στο Καλαμάκι. Εσύ;",
      "scene": 1
    },
    {
      "role": "petros",
      "text": "Εγώ μένω στην Πετρούπολη.",
      "scene": 1
    }

			},
			"offsets": {
				"from": 800,
				"to": 2360
			},
			"text": " Καλησπέρα."
		},
		{
			"timestamps": {
				"from": "00:00:02,360",
				"to": "00:00:03,900"
			},
			"offsets": {
				"from": 2360,
				"to": 3900
			},
			"text": " Καλώς ήρθατε."
		},
		{
			"timestamps": {
				"from": "00:00:03,900",
				"to": "00:00:05,380"
			},
			"offsets": {
				"from": 3900,
				"to": 5380
			},
			"text": " Τι κάνετε."
		},
		{
			"timestamps": {
				"from": "00:00:05,380",
				"to": "00:00:06,780"
			},
			"offsets": {
				"from": 5380,
				"to": 6780
			},
			"text": " Μια χαρά."
		},
		{
			"timestamps": {
				"from": "00:00:06,780",
				"to": "00:00:10,800"
			},
			"offsets": {
				"from": 6780,
				"to": 10800
			},
			"text": " Παιδιά, από εδώ η μητέρα μου, η Σοφία."
		},
		{
			"timestamps": {
				"from": "00:00:10,800",
				"to": "00:00:12,280"
			},
			"offsets": {
				"from": 10800,
				"to": 12280
			},
			"text": " Χαίρο πολύ."
		},
		{
			"timestamps": {
				"from": "00:00:12,280",
				"to": "00:00:13,620"
			},
			"offsets": {
				"from": 12280,
				"to": 13620
			},
			"text": " Κι εγώ."
		},
		{
			"timestamps": {
				"from": "00:00:13,620",
				"to": "00:00:16,840"
			},
			"offsets": {
				"from": 13620,
				"to": 16840
			},
			"text": " Κι από εδώ ο πατέρας μου, ο Γιάννης."
		},
		{
			"timestamps": {
				"from": "00:00:16,840",
				"to": "00:00:18,140"
			},
			"offsets": {
				"from": 16840,
				"to": 18140
			},
			"text": " Γεια σας."
		},
		{
			"timestamps": {
				"from": "00:00:18,140",
				"to": "00:00:19,660"
			},
			"offsets": {
				"from": 18140,
				"to": 19660
			},
			"text": " Χαίρο πολύ."
		},
		{
			"timestamps": {
				"from": "00:00:19,660",
				"to": "00:00:21,680"
			},
			"offsets": {
				"from": 19660,
				"to": 21680
			},
			"text": " Παιδιά, γεια σας."
		},
		{
			"timestamps": {
				"from": "00:00:21,680",
				"to": "00:00:26,060"
			},
			"offsets": {
				"from": 21680,
				"to": 26060
			},
			"text": " Α, να και ο μικρός μου αδελφός, ο Βαγγέλης."
		},
		{
			"timestamps": {
				"from": "00:00:26,060",
				"to": "00:00:27,160"
			},
			"offsets": {
				"from": 26060,
				"to": 27160
			},
			"text": " Γεια."
		},
		{
			"timestamps": {
				"from": "00:00:27,160",
				"to": "00:00:29,880"
			},
			"offsets": {
				"from": 27160,
				"to": 29880
			},
			"text": " Μαμά, πού είναι η Κατερίνα."
		},
		{
			"timestamps": {
				"from": "00:00:30,000",
				"to": "00:00:33,340"
			},
			"offsets": {
				"from": 30000,
				"to": 33340
			},
			"text": " Δεν είναι εδώ. Είναι ακόμα στη δουλειά."
		},
		{
			"timestamps": {
				"from": "00:00:33,340",
				"to": "00:00:35,660"
			},
			"offsets": {
				"from": 33340,
				"to": 35660
			},
			"text": " Α, ναι, σωστά."
		},
		{
			"timestamps": {
				"from": "00:00:35,660",
				"to": "00:00:37,460"
			},
			"offsets": {
				"from": 35660,
				"to": 37460
			},
			"text": " Ποια είναι η Κατερίνα?"
		},
		{
			"timestamps": {
				"from": "00:00:37,460",
				"to": "00:00:39,500"
			},
			"offsets": {
				"from": 37460,
				"to": 39500
			},
			"text": " Η μεγάλη μου αδελφή."
		},
		{
			"timestamps": {
				"from": "00:00:39,500",
				"to": "00:00:42,500"
			},
			"offsets": {
				"from": 39500,
				"to": 42500
			},
			"text": " Παιδιά, το φαγητό είναι έτοιμο."
		},
		{
			"timestamps": {
				"from": "00:00:42,500",
				"to": "00:00:48,320"
			},
			"offsets": {
				"from": 42500,
				"to": 48320
			},
			"text": " Α, το κουδούνι. Ανοίγω εγώ. Παύλο, Λουκία."
		},
		{
			"timestamps": {
				"from": "00:00:48,320",
				"to": "00:00:51,000"
			},
			"offsets": {
				"from": 48320,
				"to": 51000
			},
			"text": " Λάωρα, ποιος είναι αυτός?"
		},
		{
			"timestamps": {
				"from": "00:00:51,000",
				"to": "00:00:55,900"
			},
			"offsets": {
				"from": 51000,
				"to": 55900
			},
			"text": " Αυτός είναι ο ξάδερφός του. Είναι συμφοιτητής μας στη νομική."
		},
		{
			"timestamps": {
				"from": "00:00:55,900",
				"to": "00:00:57,440"
			},
			"offsets": {
				"from": 55900,
				"to": 57440
			},
			"text": " Και εκείνη εκεί."
		},
		{
			"timestamps": {
				"from": "00:00:57,440",
				"to": "00:00:59,220"
			},
			"offsets": {
				"from": 57440,
				"to": 59220
			},
			"text": " Είναι η κοπέλα του."
		},
		{
			"timestamps": {
				"from": "00:01:00,000",
				"to": "00:01:03,440"
			},
			"offsets": {
				"from": 60000,
				"to": 63440
			},
			"text": " Παιδιά, καλώς ήρθατε. Γεια σας."
		},
		{
			"timestamps": {
				"from": "00:01:03,440",
				"to": "00:01:07,960"
			},
			"offsets": {
				"from": 63440,
				"to": 67960
			},
			"text": " Πάνω στην ώρα, σε λίγο τρώμε. Ελάτε."
		}
	]

  "turns": [
    {
      "role": "laura_flavian",
      "text": "Καλησπέρα!",
      "scene": 1
    },
    {
      "role": "nikos",
      "text": "Καλησπέρα! Καλώς ήρθατε. Τι κάνετε;",
      "scene": 1
    },
    {
      "role": "flavian",
      "text": "Μια χαρά.",
      "scene": 1
    },
    {
      "role": "nikos",
      "text": "Παιδιά, από εδώ η μητέρα μου, η Σοφία.",
      "scene": 1
    },
    {
      "role": "flavian",
      "text": "Χαίρω πολύ.",
      "scene": 1
    },
    {
      "role": "sofia",
      "text": "Κι εγώ.",
      "scene": 1
    },
    {
      "role": "nikos",
      "text": "Κι από εδώ ο πατέρας μου, ο Γιάννης.",
      "scene": 1
    },
    {
      "role": "giannis",
      "text": "Γεια σας.",
      "scene": 1
    },
    {
      "role": "laura",
      "text": "Χαίρω πολύ.",
      "scene": 1
    },
    {
      "role": "vangelis",
      "text": "Παιδιά, γεια σας.",
      "scene": 1
    },
    {
      "role": "nikos",
      "text": "Α, να και ο μικρός μου αδελφός, ο Βαγγέλης.",
      "scene": 1
    },
    {
      "role": "laura",
      "text": "Γεια.",
      "scene": 1
    },
    {
      "role": "nikos",
      "text": "Μαμά, πού είναι η Κατερίνα;",
      "scene": 1
    },
    {
      "role": "sofia",
      "text": "Δεν είναι εδώ. Είναι ακόμα στη δουλειά.",
      "scene": 1
    },
    {
      "role": "nikos",
      "text": "Α, ναι, σωστά.",
      "scene": 1
    },
    {
      "role": "laura",
      "text": "Ποια είναι η Κατερίνα;",
      "scene": 1
    },
    {
      "role": "nikos",
      "text": "Η μεγάλη μου αδελφή.",
      "scene": 1
    },
    {
      "role": "sofia",
      "text": "Παιδιά, το φαγητό είναι έτοιμο.",
      "scene": 1
    },
    {
      "role": "nikos",
      "text": "Α, το κουδούνι. Ανοίγω εγώ. Παύλο, Λουκία.",
      "scene": 1
    },
    {
      "role": "flavian",
      "text": "Λάουρα, ποιος είναι αυτός;",
      "scene": 1
    },
    {
      "role": "laura",
      "text": "Αυτός είναι ο ξάδερφός του. Είναι συμφοιτητής μας στη νομική.",
      "scene": 1
    },
    {
      "role": "flavian",
      "text": "Και εκείνη εκεί;",
      "scene": 1
    },
    {
      "role": "laura",
      "text": "Είναι η κοπέλα του.",
      "scene": 1
    },
    {
      "role": "sofia",
      "text": "Παιδιά, καλώς ήρθατε.",
      "scene": 1
    },
    {
      "role": "pavlos_loukia",
      "text": "Γεια σας.",
      "scene": 1
    },
    {
      "role": "nikos",
      "text": "Πάνω στην ώρα, σε λίγο τρώμε. Ελάτε.",
      "scene": 1
    }
  ]

  "turns": [
    {
      "role": "flavian",
      "text": "Γεια σου! Πώς σε λένε;",
      "scene": 1
    },
    {
      "role": "anne",
      "text": "Γεια! Με λένε Άνε. Εσένα, πώς σε λένε;",
      "scene": 1
    },
    {
      "role": "flavian",
      "text": "Είμαι ο Φλαβιάν. Χαίρω πολύ!",
      "scene": 1
    },
    {
      "role": "anne",
      "text": "Κι εγώ!",
      "scene": 1
    },
    {
      "role": "flavian",
      "text": "Από πού είσαι, Άνε;",
      "scene": 1
    },
    {
      "role": "anne",
      "text": "Είμαι από την Ισπανία. Από τη Μαδρίτη. Εσύ;",
      "scene": 1
    },
    {
      "role": "flavian",
      "text": "Εγώ είμαι από τη Γαλλία. Από το Παρίσι.",
      "scene": 1
    },
    {
      "role": "anne",
      "text": "Ωραία! Τα λέμε στο μάθημα, ε!",
      "scene": 1
    },
    {
      "role": "flavian",
      "text": "Ναι! Πώς λένε τον καθηγητή;",
      "scene": 1
    },
    {
      "role": "anne",
      "text": "Πώς τον λένε... δεν ξέρω.",
      "scene": 1
    },
    {
      "role": "flavian",
      "text": "Εντάξει, τα λέμε λοιπόν Χάρηκα πολύ",
      "scene": 1
    },
    {
      "role": "anne",
      "text": "Κι εγώ, αντίο",
      "scene": 1
    },
    {
      "role": "flavian",
      "text": "Γεια χαρά",
      "scene": 1
    }
  ]

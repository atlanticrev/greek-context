    }
  },
  "turns": [
    {
      "role": "paola",
      "text": "Τι ωραίο πάρτι!",
      "scene": 1
    },
    {
      "role": "eleni",
      "text": "Ναι, πράγματι! Έχει φανταστική μουσική και πολύ κέφι!",
      "scene": 1
    },
    {
      "role": "paola",
      "text": "Ελένη, θες κρασί ή μπύρα;",
      "scene": 1
    },
    {
      "role": "eleni",
      "text": "Ένα ποτήρι κρασί, σε παρακαλώ!",
      "scene": 1
    },
    {
      "role": "paola",
      "text": "Λευκό ή κόκκινο;",
      "scene": 1
    },
    {
      "role": "eleni",
      "text": "Κόκκινο!",
      "scene": 1
    },
    {
      "role": "paola",
      "text": "Έλα, στην υγειά σου!",
      "scene": 1
    },
    {
      "role": "eleni",
      "text": "Στην υγειά μας! Ποιος είναι αυτός εκεί;",
      "scene": 1
    },
    {
      "role": "paola",
      "text": "Ποιος; Αυτός δίπλα στη Μόνικα;",
      "scene": 1
    },
    {
      "role": "eleni",
      "text": "Ναι. Πολύ όμορφος, ε.",
      "scene": 1
    },
    {
      "role": "paola",
      "text": "Καλός είναι. Τον λένε Μπρους. Είναι καθηγητής μαθηματικών. Είναι Αυστραλός και είναι πολύ συμπαθητικός.",
      "scene": 1
    },
    {
      "role": "eleni",
      "text": "Και αυτή η κοπέλα με τον Αλέκο, ποια είναι; Αυτή εκεί με το μαύρο φόρεμα.",
      "scene": 1
    },
    {
      "role": "paola",
      "text": "Μια καινούρια μαθήτρια στην τάξη μου. Είναι Ολλανδέζα. Δεν ξέρω πώς τη λένε.",
      "scene": 1
    },
    {
      "role": "eleni",
      "text": "Ψηλή κοπέλα, ε. Και με μοντέρνο στυλ. Είναι η κοπέλα του.",
      "scene": 1
    },
    {
      "role": "paola",
      "text": "Λες. Δεν ξέρω. Μπορεί.",
      "scene": 1
    }
  ]
}

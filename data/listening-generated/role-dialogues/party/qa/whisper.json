			"offsets": {
				"from": 0,
				"to": 880
			},
			"text": " Τι ωραίο πάρτι."
		},
		{
			"timestamps": {
				"from": "00:00:00,880",
				"to": "00:00:06,200"
			},
			"offsets": {
				"from": 880,
				"to": 6200
			},
			"text": " Ναι, πράγματι. Έχει φανταστική μουσική και πολύ κέφι."
		},
		{
			"timestamps": {
				"from": "00:00:06,200",
				"to": "00:00:09,180"
			},
			"offsets": {
				"from": 6200,
				"to": 9180
			},
			"text": " Ελένη, θες κρασί ή μπύρα."
		},
		{
			"timestamps": {
				"from": "00:00:09,180",
				"to": "00:00:12,540"
			},
			"offsets": {
				"from": 9180,
				"to": 12540
			},
			"text": " Ένα ποτήρι κρασί, σε παρακαλώ."
		},
		{
			"timestamps": {
				"from": "00:00:12,540",
				"to": "00:00:14,420"
			},
			"offsets": {
				"from": 12540,
				"to": 14420
			},
			"text": " Λευκό ή κόκκινο."
		},
		{
			"timestamps": {
				"from": "00:00:14,420",
				"to": "00:00:15,840"
			},
			"offsets": {
				"from": 14420,
				"to": 15840
			},
			"text": " Κόκκινο."
		},
		{
			"timestamps": {
				"from": "00:00:15,840",
				"to": "00:00:18,660"
			},
			"offsets": {
				"from": 15840,
				"to": 18660
			},
			"text": " Έλα, στην υγειά σου."
		},
		{
			"timestamps": {
				"from": "00:00:18,660",
				"to": "00:00:22,120"
			},
			"offsets": {
				"from": 18660,
				"to": 22120
			},
			"text": " Στην υγειά μας. Ποιος είναι αυτός εκεί."
		},
		{
			"timestamps": {
				"from": "00:00:22,120",
				"to": "00:00:25,100"
			},
			"offsets": {
				"from": 22120,
				"to": 25100
			},
			"text": " Ποιος. Αυτός δίπλα στη Μόνικα."
		},
		{
			"timestamps": {
				"from": "00:00:25,100",
				"to": "00:00:28,400"
			},
			"offsets": {
				"from": 25100,
				"to": 28400
			},
			"text": " Ναι. Πολύ όμορφος, ε."
		},
		{
			"timestamps": {
				"from": "00:00:28,400",
				"to": "00:00:29,880"
			},
			"offsets": {
				"from": 28400,
				"to": 29880
			},
			"text": " Καλός είναι."
		},
		{
			"timestamps": {
				"from": "00:00:30,000",
				"to": "00:00:37,220"
			},
			"offsets": {
				"from": 30000,
				"to": 37220
			},
			"text": " Τον λένε Μπρους. Είναι καθηγητής μαθηματικών. Είναι Αυστραλός και είναι πολύ συμβαθητικός."
		},
		{
			"timestamps": {
				"from": "00:00:37,220",
				"to": "00:00:43,120"
			},
			"offsets": {
				"from": 37220,
				"to": 43120
			},
			"text": " Και αυτή η κοπέλα με τον Αλέκο ποια είναι. Αυτή εκεί με το μαύρο φόρεμα."
		},
		{
			"timestamps": {
				"from": "00:00:43,120",
				"to": "00:00:49,320"
			},
			"offsets": {
				"from": 43120,
				"to": 49320
			},
			"text": " Μια καινούρια μαθήτρια στην τάξη μου. Είναι Ολλανδέζα. Δεν ξέρω πώς τη λένε."
		},
		{
			"timestamps": {
				"from": "00:00:49,320",
				"to": "00:00:54,920"
			},
			"offsets": {
				"from": 49320,
				"to": 54920
			},
			"text": " Ψιλή κοπέλα. Ε. Και με μοντέρνο στυλ. Είναι η κοπέλα του."
		},
		{
			"timestamps": {
				"from": "00:00:54,920",
				"to": "00:00:58,960"
			},
			"offsets": {
				"from": 54920,
				"to": 58960
			},
			"text": " Λες. Δεν ξέρω. Μπορεί."
		}
	]
}
